# Tally Backend — Configuration Template
# Copy to .env and fill in real values. DO NOT commit .env (it holds secrets).
# The authoritative list of settings is app/core/config.py — keep this in sync with it.

ENVIRONMENT=development
DEBUG=true

# --- Supabase (REQUIRED) ---
# Settings -> API. SUPABASE_KEY is the SERVER-SIDE secret: sb_secret_... on new
# projects, or the legacy service_role JWT. (This key BYPASSES RLS — server only.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-sb_secret-key
# Optional: ONLY for legacy projects that still sign user tokens with HS256.
# Projects on asymmetric signing keys (ES256/RS256) verify via JWKS and ignore this.
SUPABASE_JWT_SECRET=
# Private Storage bucket where original statements are archived (create it once,
# PRIVATE, in the dashboard). Defaults to "statements".
SUPABASE_STATEMENTS_BUCKET=statements

# --- LLM providers ---
# PRIMARY path is Google Gemini with KEY ROTATION: put one or more free-tier
# Google AI Studio keys here, comma-separated. The client round-robins and
# advances on quota/429. WITHOUT these, categorization/chat fall back to
# deterministic (non-AI) output. Get keys: https://aistudio.google.com/apikey
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# FALLBACK when every Gemini key is cooling down: OpenRouter's free Nemotron.
# Field name is SINGULAR. Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- API ---
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- File Upload ---
MAX_FILE_SIZE_MB=50
UPLOAD_TIMEOUT_SECONDS=300
ALLOWED_FILE_TYPES=pdf,csv,xlsx

# --- Feature Flags ---
ENABLE_OCR=false                 # scanned-PDF OCR is not wired in the live path
ENABLE_LLM_CATEGORIZATION=true
ENABLE_EVENT_SUMMARIZATION=true

# --- Monitoring / Logging (optional) ---
SENTRY_DSN=
LOG_LEVEL=INFO

# ============================================================================
# DEPLOYED (Render) — what changes from the local values above
# ============================================================================
# ENVIRONMENT=production        # also disables /docs, /redoc and /openapi.json
# DEBUG=false
# CORS_ORIGINS=https://<your-app>.vercel.app
#   Exact origins, comma-separated, NO trailing slash. The browser sends
#   Origin without one, and a mismatch shows up as a CORS failure that looks
#   like the backend being down.
#
# SUPABASE_URL / SUPABASE_KEY: same project as local. SUPABASE_KEY bypasses
#   row-level security, so it belongs only in Render's encrypted env vars —
#   never in the frontend, never in git.
#
# The frontend's own variables (NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_API_URL) are set in the VERCEL
# dashboard, not here: Next.js inlines them at BUILD time, so setting them as
# runtime env produces a bundle with `undefined` in it.
